# ==============================================================================
# Dragonwilds AWS Environment Configuration Template
# Copy this file to `.env` and fill in the values for your AWS account.
# Note: Keep actual credentials and secret values out of version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS Account & CLI Configuration
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default

# AWS IAM Role to assume for CI/CD OIDC or automated deployment
# AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/DragonwildsDeploymentRole

# ------------------------------------------------------------------------------
# AMI & Build Configuration
# ------------------------------------------------------------------------------
# Fallback base AMI ID or previous hardened golden image (for fast incremental bakes)
BASE_AMI_ID=ami-0123456789abcdef0

# Newly baked AMI ID to deploy (optional; resolved from stack if omitted)
# BAKED_AMI_ID=ami-0abcdef1234567890

# Build type for CI/CD: 'auto', 'fast', 'master', or 'deploy-only'
REQUESTED_BUILD=auto

# ------------------------------------------------------------------------------
# CloudFormation Deployment Configuration
# ------------------------------------------------------------------------------
STACK_NAME=dragonwilds
CFN_TEMPLATE=cloudformation/server.yaml
# Existing private bucket used by `aws cloudformation package` for nested templates
CFN_ARTIFACT_BUCKET=my-dragonwilds-cloudformation-artifacts

# Secrets Manager Secret ARN containing the required RSDW_* server parameters
SERVER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:dragonwilds/production/server-secret-AbCdEf

# Optional: Initial world save import from an S3 bucket
# Both WORLD_SAVE_BUCKET and WORLD_SAVE_KEY must be populated together to enable import
# WORLD_SAVE_BUCKET=my-dragonwilds-backups-bucket
# WORLD_SAVE_KEY=saves/homeworld.sav

# ------------------------------------------------------------------------------
# RuneScape: Dragonwilds Dedicated Server Configuration
# These values are stored as a JSON object in AWS Secrets Manager:
# ------------------------------------------------------------------------------
# RSDW_OWNER_ID=76561198000000000
# RSDW_PORT=7777
# RSDW_BEACON_PORT=8888
# RSDW_SERVER_NAME=My Dragonwilds Server
# RSDW_WORLD_NAME=My World
# RSDW_PASSWORD=
# RSDW_ADMINS=76561198000000000
# RSDW_ADMIN_PASSWORD=SetAStrongManagementPasswordHere!
# RSDW_ADDITIONAL_ARGS=
# RSDW_AUTO_STOP_ON_UPDATE=true
