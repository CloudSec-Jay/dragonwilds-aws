# Example Packer variables for dragonwilds-aws AMI builds
# Copy to variables.pkrvars.hcl and customize as needed.

aws_region          = "us-east-1"
build_instance_type = "t3.medium"
root_volume_size    = 20

# Required when building with packer/dragonwilds-update.pkr.hcl:
# base_ami_id       = "ami-0123456789abcdef0"

# Required when auditing with packer/cis-audit.pkr.hcl:
# ami_id            = "ami-0123456789abcdef0"
